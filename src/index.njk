<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERPNext Automation - Real Workflows for Small Business</title>
  <meta name="description" content="Practical ERPNext automation scripts and guides. Real Python workflows for purchase orders, invoices, inventory, and Azure integration.">
  <link rel="canonical" href="https://erpnext-automation.pages.dev/">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #1a1a1a; background: #fff; margin: 0; line-height: 1.7; }
    .container { max-width: 780px; margin: 0 auto; padding: 2rem 1.5rem; }
    h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
    .lead { font-size: 1.1rem; color: #444; margin-bottom: 2rem; }
    .posts { list-style: none; padding: 0; }
    .posts li { border-bottom: 1px solid #eee; padding: 1.2rem 0; }
    .posts a { font-size: 1.2rem; font-weight: 600; color: #0070f3; text-decoration: none; }
    .posts a:hover { text-decoration: underline; }
    .posts .desc { color: #555; font-size: 0.95rem; margin-top: 0.3rem; }
    footer { margin-top: 4rem; color: #888; font-size: 0.85rem; }
  </style>
</head>
<body>
  <div class="container">
    <h1>ERPNext Automation</h1>
    <p class="lead">Practical automation scripts and guides for ERPNext — tested in production.</p>
    <ul class="posts">
    {% for post in collections.all | reverse %}
      {% if post.data.permalink and post.data.title %}
      <li>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        {% if post.data.description %}<div class="desc">{{ post.data.description }}</div>{% endif %}
      </li>
      {% endif %}
    {% endfor %}
    </ul>
    <footer>&copy; 2026 ERPNext Automation</footer>
  </div>
</body>
</html>
